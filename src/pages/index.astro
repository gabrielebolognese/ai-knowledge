---
// Placeholder landing page from the scaffold step. The landing-page step replaces this file.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="AI Knowledge">
  <main id="main" class="container placeholder">
    <p class="eyebrow muted">Free deep learning course</p>
    <h1>From installing Python to a neural-network chess engine.</h1>
    <p class="t-lead">A read-only, sourced, Wikipedia-style course. Progress is saved in this browser only.</p>
    <p><a class="btn btn-primary btn-lg" href="/course/">Open the course</a></p>
  </main>
</BaseLayout>
<style>
  .placeholder { padding-top: var(--s-9); padding-bottom: var(--s-9); }
  .placeholder h1 { font-size: var(--t-display); line-height: var(--lh-display); letter-spacing: -0.02em; max-width: 18ch; margin: var(--s-3) 0 var(--s-5); }
</style>
