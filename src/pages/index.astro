<script>
  // Citation preview: hovering or focusing a superscript highlights its reference.
  const sample = document.querySelector('.sample');
  if (sample) {
    const set = (n: string | null) =>
      sample.querySelectorAll<HTMLElement>('[data-ref-item]').forEach((li) => li.classList.toggle('is-hl', li.dataset.refItem === n));
    sample.querySelectorAll<HTMLAnchorElement>('[data-ref]').forEach((a) => {
      a.addEventListener('pointerenter', () => set(a.dataset.ref!));
      a.addEventListener('focus', () => set(a.dataset.ref!));
      a.addEventListener('pointerleave', () => set(null));
      a.addEventListener('blur', () => set(null));
    });
  }
</script>

