---
// Landing page (research/05-ux-design-brief.md §5.1, §6.1, §7).
// Every number on this page is computed at build time from src/data/curriculum.json.
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/ui/Wordmark.astro';
import LevelBadge from '../components/ui/LevelBadge.astro';
import HeroNet from '../components/landing/HeroNet.astro';
import ProjectArt from '../components/landing/ProjectArt.astro';
import CertificateThumb from '../components/landing/CertificateThumb.astro';
import { getCourse, lessonUrl } from '../lib/course';
import curriculum from '../data/curriculum.json';

type Level = 'beginner' | 'intermediate' | 'advanced';
interface CLesson { slug: string; title: string; track: string; minutes: number }
interface CModule { id: string; title: string; lessons: CLesson[] }
interface CTrack { id: string; title: string; kind: string; level: Level; optional?: boolean; blurb: string; outcome?: string; modules: CModule[] }

const tracks = curriculum.tracks as unknown as CTrack[];
const trackById = (id: string) => {
  const t = tracks.find((x) => x.id === id);
  if (!t) throw new Error(`curriculum.json has no track "${id}"`);
  return t;
};
const lessonsOf = (t: { modules: CModule[] }) => t.modules.flatMap((m) => m.lessons);
const minutesOf = (ls: CLesson[]) => ls.reduce((s, l) => s + l.minutes, 0);
const fmtHours = (min: number) => {
  const h = Math.round((min / 60) * 2) / 2;
  return `${h % 1 ? h.toFixed(1) : h} h`;
};

// ---- Totals ----
const allLessons = [...new Map(tracks.flatMap(lessonsOf).map((l) => [l.slug, l])).values()];
const totalLessons = allLessons.length;
const totalMinutes = minutesOf(allLessons);
const sourceRegistry = curriculum.sourceRegistry as Record<string, { title: string; url: string; publisher: string }>;
const totalSources = Object.keys(sourceRegistry).length;
const projectTracks = tracks.filter((t) => t.kind === 'project');
const projectLessons = projectTracks.flatMap(lessonsOf);

// ---- The path (core tracks) ----
const path = ['setup', 'beginner', 'intermediate', 'advanced'].map((id) => {
  const t = trackById(id);
  const ls = lessonsOf(t);
  return { id, title: t.title, level: t.level, optional: !!t.optional, blurb: t.blurb, modules: t.modules.length, lessons: ls.length, minutes: minutesOf(ls), slugs: ls.map((l) => l.slug) };
});
const coreRequiredLessons = path.filter((p) => !p.optional).reduce((s, p) => s + p.lessons, 0);

// ---- Entry links (only to pages that exist in this build) ----
const course = await getCourse();
const written = new Set(course.flatMap((t) => t.lessons.map((l) => l.data.slug)));
const firstWritten = (ls: CLesson[]) => ls.find((l) => written.has(l.slug));
const trackPages = import.meta.glob('/src/pages/course/[track]/index.astro');
const setupTrack = trackById('setup');
const firstSetup = firstWritten(lessonsOf(setupTrack));
const setupHref = Object.keys(trackPages).length || !firstSetup ? '/course/setup/' : lessonUrl(firstSetup);
const firstBeginner = firstWritten(lessonsOf(trackById('beginner')));

// ---- Project showcase: six projects (digits and letters share one track, split by module) ----
type Art = 'digit' | 'letter' | 'doodle' | 'text' | 'code' | 'chess';
const projectCard = (art: Art, title: string, tagline: string, trackId: string, moduleId?: string) => {
  const t = trackById(trackId);
  const scope = moduleId ? t.modules.filter((m) => m.id === moduleId) : t.modules;
  if (!scope.length) throw new Error(`curriculum.json: track ${trackId} has no module ${moduleId}`);
  const ls = lessonsOf({ modules: scope });
  const first = firstWritten(ls) ?? ls[0];
  return { art, title, tagline, level: t.level, lessons: ls.length, minutes: minutesOf(ls), href: lessonUrl({ track: trackId, slug: first.slug }), trackTitle: t.title };
};
const showcase = [
  projectCard('digit', 'Handwritten digits', 'Train a network on MNIST, then draw a number and watch it read your handwriting.', 'project-digits-letters', 'digits'),
  projectCard('letter', 'Handwritten letters', 'Extend the same model to the 26 letters of EMNIST, where look-alikes such as l and I make it harder.', 'project-digits-letters', 'letters'),
  projectCard('doodle', 'Doodle recognition', 'Stream real sketches from Quick, Draw! and build a canvas app that guesses while you draw.', 'project-doodles'),
  projectCard('text', 'Small-text models', 'Invent new names character by character, write Shakespeare-like text and classify the sentiment of short reviews.', 'project-text'),
  projectCard('code', 'Code autocompletion', 'Train a tiny GPT on Python’s own standard library and let it finish your lines.', 'project-code-autocomplete'),
  projectCard('chess', 'Mini chess engine', 'Alpha-beta search with a neural-network evaluator: a small engine in the spirit of Stockfish that speaks UCI.', 'project-chess'),
];

// ---- Sources section: a real paragraph with real references from the registry ----
const refIds = ['mcculloch1943', 'rosenblatt1958', 'rumelhart1986', 'lecun1998'];
const refs = refIds.map((id) => {
  const s = sourceRegistry[id];
  if (!s) throw new Error(`sourceRegistry has no ${id}`);
  return s;
});

const certReq = curriculum.certificateRequirement as { description: string; allLessonsInTracks: string[]; minProjectTracksCompleted: number };
const firstTrackLabel = path.find((p) => !p.optional)!;
---
<BaseLayout title="AI Knowledge" description={`A free, sourced, Wikipedia-style deep learning course: ${totalLessons} lessons from installing Python to a neural-network chess engine. No account; progress stays in your browser.`} bodyClass="landing">
  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__wash" aria-hidden="true"></div>
      <div class="container hero__grid">
        <div class="hero__copy">
          <p class="eyebrow hero__eyebrow"><span>Free</span><i aria-hidden="true"></i><span>Self-paced</span><i aria-hidden="true"></i><span>No account</span></p>
          <h1 id="hero-title" class="hero__title">Learn deep learning from zero to building your own chess engine <span class="hero__free">— free</span></h1>
          <p class="t-lead hero__lead">From installing Python to six working neural networks: handwriting, doodles, text, code completion and a chess engine. Short, sourced lessons with the math shown one piece at a time.</p>
          <div class="hero__ctas">
            <a class="btn btn-primary btn-lg" href="/course/" data-cta="start">
              Start the course
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <a class="btn btn-lg hero__alt" href={setupHref} data-cta="setup">
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><rect x="2.5" y="3.5" width="13" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M5.5 7l2 1.5-2 1.5M9.5 10.5h3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              Set up Python first
            </a>
            <a class="btn btn-lg hero__alt" href="/projects/" data-cta="projects">
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><rect x="2.5" y="2.5" width="5.5" height="5.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" /><rect x="10" y="2.5" width="5.5" height="5.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" /><rect x="2.5" y="10" width="5.5" height="5.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" /><circle cx="12.75" cy="12.75" r="2.9" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              Jump to a project
            </a>
          </div>
          <p class="hero__note">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            Progress stays in your browser. Certificate when you finish.
          </p>
        </div>
        <HeroNet />
      </div>
      <div class="container">
        <ul class="trust" aria-label="The course in numbers">
          <li><strong>{totalLessons}</strong> lessons</li>
          <li><strong>{showcase.length}</strong> projects</li>
          <li><strong>{totalSources}</strong> cited sources</li>
          <li><strong>{fmtHours(totalMinutes).replace(' h', '')}</strong> hours of reading</li>
          <li><strong>0</strong> accounts or fees</li>
        </ul>
      </div>
    </section>

    <!-- ============ THREE WAYS IN ============ -->
    <section class="section ways" aria-labelledby="ways-title">
      <div class="container">
        <header class="section__head">
          <p class="eyebrow section__eyebrow">Three ways in</p>
          <h2 id="ways-title">Start where you are</h2>
          <p class="section__sub">Nothing is locked. Prerequisites are advice, not walls, so you can begin at the very first step or jump straight to the thing you want to build.</p>
        </header>
        <div class="ways__grid">
          <a class="way" href={setupHref}>
            <span class="way__num">1</span>
            <h3>Start from zero</h3>
            <p>Install Python, VS Code and PyTorch on Windows, macOS or Linux, with direct download links and annotated screenshots. Optional: skip it or use Google Colab.</p>
            <span class="way__meta">{path[0].lessons} lessons · {fmtHours(path[0].minutes)}</span>
            <span class="way__go">Set up Python <span aria-hidden="true">→</span></span>
          </a>
          <a class="way way--main" href="/course/">
            <span class="way__num">2</span>
            <h3>Take the full course</h3>
            <p>Beginner to advanced: the math with analogies, your first neuron, backpropagation, PyTorch, CNNs, RNNs and Transformers.</p>
            <span class="way__meta">{coreRequiredLessons} lessons · {fmtHours(path.filter((p) => !p.optional).reduce((s, p) => s + p.minutes, 0))}</span>
            <span class="way__go">Open the course <span aria-hidden="true">→</span></span>
          </a>
          <a class="way" href="/projects/">
            <span class="way__num">3</span>
            <h3>Learn by building</h3>
            <p>Pick one of the {showcase.length} projects. Each has a quick-start list of the exact lessons it needs, so you learn only what the project uses.</p>
            <span class="way__meta">{projectTracks.length} project tracks · {projectLessons.length} lessons</span>
            <span class="way__go">Browse projects <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ HOW IT WORKS ============ -->
    <section class="section how" aria-labelledby="how-title">
      <div class="container">
        <header class="section__head">
          <p class="eyebrow section__eyebrow">How it works</p>
          <h2 id="how-title">Read, check, mark, earn</h2>
          <p class="section__sub">Lessons are 10 to 30 minutes long. Each one is a short article that you can finish in a single sitting.</p>
        </header>
        <ol class="how__steps">
          <li class="step">
            <div class="step__icon"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 7.5c3.5-1.5 7.5-1.5 11 1 3.5-2.5 7.5-2.5 11-1v17c-3.5-1.5-7.5-1.5-11 1-3.5-2.5-7.5-2.5-11-1z M16 8.5v17" /></svg></div>
            <h3><span class="step__n">1</span> Read</h3>
            <p>A short, encyclopaedia-style article: an analogy first, then a tiny worked example, then the symbols one at a time.</p>
            <div class="mock mock--math"><span class="mock__k">Step 2 of 4</span><span class="mock__eq"><var>z</var> = <var>w</var>·<var>x</var> + <var>b</var></span></div>
          </li>
          <li class="step">
            <div class="step__icon"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 8a3 3 0 0 1 3-3h14a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-8l-6 5v-5H9a3 3 0 0 1-3-3z M11.5 13.5l3 3 6-6" /></svg></div>
            <h3><span class="step__n">2</span> Check yourself</h3>
            <p>Quick questions with instant feedback and hints. Every exercise also lives in the library, so you can practise anytime.</p>
            <div class="mock mock--quiz"><span class="mock__ok" aria-hidden="true">✓</span> Correct: 2·1 + 3 = 5</div>
          </li>
          <li class="step">
            <div class="step__icon"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="11" /><path d="M11 16.5l3.5 3.5 7-7.5" /></svg></div>
            <h3><span class="step__n">3</span> Mark complete</h3>
            <p>One click saves it in this browser. Undo whenever you like: you have full control over what counts as done.</p>
            <div class="mock mock--done"><span class="mock__check" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M2.5 6.2l2.3 2.3 4.7-5" /></svg></span> Completed · Undo</div>
          </li>
          <li class="step">
            <div class="step__icon step__icon--gold"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="12" r="7" /><path d="M11.5 17.5 9 27l7-3.5 7 3.5-2.5-9.5" /></svg></div>
            <h3><span class="step__n">4</span> Earn the certificate</h3>
            <p>Finish the core path and one project, type your name, and download a certificate as a PNG or PDF.</p>
            <div class="mock mock--cert"><span class="mock__seal" aria-hidden="true"></span> Certificate ready</div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ THE PATH ============ -->
    <section class="section path" aria-labelledby="path-title">
      <div class="container">
        <header class="section__head">
          <p class="eyebrow section__eyebrow">The path</p>
          <h2 id="path-title">From your first install to Transformers</h2>
          <p class="section__sub">{tracks.length} tracks, {curriculum.tracks.reduce((s, t) => s + t.modules.length, 0)} modules and {totalLessons} lessons. The four core stops build on each other, and the projects branch off once you have the basics.</p>
        </header>
        <ol class="path__line">
          {path.map((p, i) => (
            <li class={`stop stop--${p.level}${p.optional ? ' stop--optional' : ''}`} data-track={p.id}>
              <div class="stop__marker" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  {p.id === 'setup' && <rect x="5" y="5" width="14" height="14" rx="3" />}
                  {p.id === 'beginner' && <circle cx="12" cy="12" r="7.5" />}
                  {p.id === 'intermediate' && <path d="M12 3.5 20.5 12 12 20.5 3.5 12Z" />}
                  {p.id === 'advanced' && <path d="M7 4.2h10l5 7.8-5 7.8H7L2 12Z" />}
                </svg>
              </div>
              <article class="stop__card" data-progress-slugs={p.slugs.join(',')}>
                <div class="stop__top">
                  <span class="stop__idx">{String(i + 1).padStart(2, '0')}</span>
                  {p.optional ? <span class="tag-optional">Optional</span> : <LevelBadge level={p.level} />}
                </div>
                <h3>{p.title}</h3>
                <p>{p.blurb}</p>
                <dl class="stop__stats">
                  <div><dt>Modules</dt><dd>{p.modules}</dd></div>
                  <div><dt>Lessons</dt><dd>{p.lessons}</dd></div>
                  <div><dt>Reading</dt><dd>{fmtHours(p.minutes)}</dd></div>
                </dl>
                <p class="stop__progress"><span class="stop__bar" aria-hidden="true"><span></span></span><span data-progress-text>0 / {p.lessons}</span> done in this browser</p>
              </article>
            </li>
          ))}
        </ol>
        <p class="path__branch">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3v8a4 4 0 0 0 4 4h6M12 12l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Plus <strong>{projectTracks.length} project tracks</strong> ({projectLessons.length} lessons, {fmtHours(minutesOf(projectLessons))}) that branch off the core path.{' '}
          {firstBeginner && <>Already set up? <a href={lessonUrl(firstBeginner)}>Skip to {firstTrackLabel.title} lesson&nbsp;1</a>.</>}
        </p>
      </div>
    </section>

    <!-- ============ PROJECTS ============ -->
    <section class="section projects" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <header class="section__head section__head--row">
          <div>
            <p class="eyebrow section__eyebrow">What you will build</p>
            <h2 id="projects-title">Six neural networks, each one yours</h2>
            <p class="section__sub">Each project comes with companion Python code that runs on an ordinary laptop CPU, and lessons that walk through it line by line.</p>
          </div>
          <a class="btn" href="/projects/">All projects <span aria-hidden="true">→</span></a>
        </header>
        <div class="projects__grid">
          {showcase.map((p) => (
            <a class="project-card" href={p.href}>
              <div class="project-card__art"><ProjectArt kind={p.art} /></div>
              <div class="project-card__body">
                <div class="project-card__meta"><LevelBadge level={p.level} /><span>{p.lessons} lessons · {fmtHours(p.minutes)}</span></div>
                <h3>{p.title}</h3>
                <p>{p.tagline}</p>
                <span class="project-card__go">Open project <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ SOURCES ============ -->
    <section class="section sources" aria-labelledby="sources-title">
      <div class="container sources__grid">
        <div class="sources__copy">
          <p class="eyebrow section__eyebrow">Wikipedia-grade sources</p>
          <h2 id="sources-title">Sourced like an encyclopaedia</h2>
          <p class="section__sub">Every factual claim carries a numbered citation that links to where it came from. You never have to take the course’s word for anything.</p>
          <ul class="checks">
            <li><strong>Numbered citations.</strong> Hover a superscript to preview the source; click to jump to the References list at the end of the lesson.</li>
            <li><strong>Primary sources first.</strong> Original papers and official documentation, with textbooks and Wikipedia for definitions.</li>
            <li><strong>{totalSources} sources</strong> in the course’s registry, each one a direct HTTPS link.</li>
            <li><strong>Setup steps link to the real download pages</strong>, with screenshots of exactly what to click.</li>
          </ul>
        </div>
        <figure class="sample" aria-label="Example of a sourced paragraph">
          <div class="sample__page">
            <p class="sample__kicker">From the Beginner track</p>
            <p class="sample__text" data-sample>
              The first mathematical model of a neuron was published in <span class="nw">1943.<sup class="sample__cite"><a href="#lref-1" data-ref="1">[1]</a></sup></span>
              Fifteen years later, the perceptron learned its own weights from <span class="nw">examples.<sup class="sample__cite"><a href="#lref-2" data-ref="2">[2]</a></sup></span>
              Backpropagation, popularised in 1986, made networks with hidden layers practical to <span class="nw">train,<sup class="sample__cite"><a href="#lref-3" data-ref="3">[3]</a></sup></span>
              and by the late 1990s convolutional networks were reading handwritten bank <span class="nw">cheques.<sup class="sample__cite"><a href="#lref-4" data-ref="4">[4]</a></sup></span>
            </p>
            <h3 class="sample__refs-title">References</h3>
            <ol class="sample__refs">
              {refs.map((r, i) => (
                <li id={`lref-${i + 1}`} data-ref-item={i + 1}>
                  <a class="ext" href={r.url} rel="noopener" target="_blank">{r.title}</a>. <em>{r.publisher}</em>.
                </li>
              ))}
            </ol>
          </div>
        </figure>
      </div>
    </section>

    <!-- ============ CERTIFICATE ============ -->
    <section class="section cert" aria-labelledby="cert-title">
      <div class="container cert__grid">
        <a class="cert__preview" href="/certificate/" aria-label="Open the certificate page">
          <CertificateThumb />
        </a>
        <div class="cert__copy">
          <p class="eyebrow section__eyebrow cert__eyebrow">Certificate</p>
          <h2 id="cert-title">Finish, type your name, download</h2>
          <p class="section__sub">A horizontal, asymmetric certificate with a guilloche rosette and a wax seal, generated in your browser as a high-resolution PNG or PDF.</p>
          <p class="cert__req"><strong>What it takes:</strong> {certReq.description}</p>
          <p class="cert__honest">It is a self-issued certificate of completion: it records that you finished this free course, not an accredited qualification.</p>
          <a class="btn btn-lg" href="/certificate/">See the certificate <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="section faq" aria-labelledby="faq-title">
      <div class="container faq__grid">
        <header class="section__head">
          <p class="eyebrow section__eyebrow">Questions</p>
          <h2 id="faq-title">Frequently asked</h2>
          <p class="section__sub">Short answers. Anything else is in the repository on GitHub.</p>
        </header>
        <div class="faq__list">
          <details open>
            <summary>Is it really free?</summary>
            <p>Yes. There is no payment system, no trial and no premium tier. The whole course, the companion code and the certificate are free, and the source is public on GitHub.</p>
          </details>
          <details>
            <summary>Do I need an account?</summary>
            <p>No. There is no sign-up and no login. Open a lesson and start reading.</p>
          </details>
          <details>
            <summary>Where is my progress stored?</summary>
            <p>Only in this browser, in <code>localStorage</code>. Nothing is sent to a server. Clearing your browser data erases it, so the course lets you export your progress as a JSON file and import it again on another computer.</p>
          </details>
          <details>
            <summary>Can I use it on my phone?</summary>
            <p>The course is designed for a computer (1024&nbsp;px or wider): lessons put code, math and diagrams side by side, and the projects run Python on your machine. On small screens you will see a polite notice.</p>
          </details>
          <details>
            <summary>Do I need a GPU or a powerful computer?</summary>
            <p>No. Every project is sized to train on an ordinary laptop CPU. If you would rather not install anything, the setup track also shows how to use Google Colab in the browser.</p>
          </details>
          <details>
            <summary>I already know some of this. Can I skip ahead?</summary>
            <p>Yes. Nothing is locked: skip the setup, start at any track, or open a project and follow its quick-start list. You can mark any lesson complete, or undo it, at any time.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ============ FINAL CTA ============ -->
    <section class="final" aria-labelledby="final-title">
      <div class="container final__inner">
        <div>
          <h2 id="final-title">Open lesson 1.</h2>
          <p>{fmtHours(totalMinutes).replace(' h', '')} hours from “what is a neuron?” to a chess engine you trained yourself.</p>
        </div>
        <a class="btn btn-lg final__btn" href="/course/">Start the course <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

  <footer class="lfoot" slot="footer">
    <div class="container lfoot__grid">
      <div class="lfoot__brand">
        <Wordmark />
        <p>A free, read-only deep learning course. Built without tracking: progress is saved only in your browser.</p>
        <a class="lfoot__gh" href="https://github.com/gabrielebolognese/ai-knowledge" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M6 5 2 9l4 4M12 5l4 4-4 4M10.5 3l-3 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          Source on GitHub
        </a>
      </div>
      <nav class="lfoot__col" aria-label="Learn">
        <h2>Learn</h2>
        <ul>
          <li><a href="/course/">Course dashboard</a></li>
          <li><a href={setupHref}>Set up Python</a></li>
          <li><a href="/exercises/">Exercise library</a></li>
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/certificate/">Certificate</a></li>
        </ul>
      </nav>
      <nav class="lfoot__col" aria-label="Projects">
        <h2>Projects</h2>
        <ul>
          {showcase.map((p) => <li><a href={p.href}>{p.title}</a></li>)}
        </ul>
