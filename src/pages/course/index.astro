---
// Placeholder course index from the scaffold step. The dashboard step replaces this file.
import BaseLayout from '../../layouts/BaseLayout.astro';
import LevelBadge from '../../components/ui/LevelBadge.astro';
import { getCourse, lessonUrl } from '../../lib/course';
const course = (await getCourse()).filter((t) => t.lessons.length);
---
<BaseLayout title="Course" active="course">
  <main id="main" class="container course-list">
    <h1>Your course</h1>
    {course.map((t) => (
      <section id={t.meta.id}>
        <h2>{t.meta.title}</h2>
        <p class="muted">{t.meta.blurb}</p>
        <ol>
          {t.lessons.map((l) => (
            <li data-lesson-status={l.data.slug}>
              <a href={lessonUrl(l)}>{l.data.title}</a> <LevelBadge level={l.data.level} /> <span class="muted">{l.data.minutes} min</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</BaseLayout>
<style>
  .course-list { padding-top: var(--s-7); }
  .course-list section { margin-top: var(--s-6); }
  .course-list li { margin: var(--s-2) 0; }
  .course-list li[data-done="true"] a::after { content: " ✓"; color: var(--success); }
</style>
