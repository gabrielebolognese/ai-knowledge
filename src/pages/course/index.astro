---
// Course dashboard (research/05-ux-design-brief.md §5.2). Every planned lesson from
// src/data/curriculum.json appears on the path map; progress comes from localStorage.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseData from '../../components/course/CourseData.astro';
import PathMap from '../../components/course/PathMap.astro';
import ProgressPanel from '../../components/course/ProgressPanel.astro';
import ProgressRing from '../../components/ui/ProgressRing.astro';
import { getCatalog, fmtMinutes } from '../../lib/catalog';

const cat = await getCatalog();
const core = cat.tracks.filter((t) => t.kind === 'core');
const projects = cat.tracks.filter((t) => t.kind === 'project');
const allSlugs = cat.all.map((l) => l.slug);
const required = cat.tracks.filter((t) => !t.optional);
const totalMinutes = required.reduce((s, t) => s + t.minutes, 0);
const written = cat.all.filter((l) => l.written).length;

// Certificate requirement (read from curriculum.json, never hard-coded).
const certCore = cat.certificate.allLessonsInTracks.flatMap((id) => cat.trackById.get(id)?.lessons.map((l) => l.slug) ?? []);
const certProjects = Object.fromEntries(cat.certificate.projectTracks.map((id) => [id, cat.trackById.get(id)?.lessons.map((l) => l.slug) ?? []]));

const skips = cat.skipPaths.map((p) => {
  const slugs = [...p.skipTracks.flatMap((id) => cat.trackById.get(id)?.lessons.map((l) => l.slug) ?? []), ...p.skipLessons];
  const start = p.startAt === 'quickStart' ? null : cat.bySlug.get(p.startAt);
  return { ...p, slugs, href: start ? start.url : '/projects/', startTitle: start ? start.title : 'Choose a project' };
});
const firstBeginner = cat.trackById.get('beginner')!.lessons[0];
---
<BaseLayout title="Your course" active="course" description="Your path through the AI Knowledge course: every lesson, your progress, and one-click completion, saved in this browser.">
  <CourseData />
  <div class="dash">
    <aside class="dash-left" aria-label="Progress by track">
      <div class="rail">
        <p class="eyebrow muted">Your progress</p>
        <div class="overall" data-progress-slugs={allSlugs.join(',')}>
          <ProgressRing slugs={allSlugs} size={88} label="Whole course: share of lessons complete" />
          <div>
            <p class="overall__num"><span data-progress-text>0 / {allSlugs.length}</span></p>
            <p class="overall__label">lessons complete</p>
          </div>
        </div>
        <ul class="rail-tracks">
          {cat.tracks.map((t) => {
            const slugs = t.lessons.map((l) => l.slug);
            return (
              <li data-progress-slugs={slugs.join(',')}>
                <a href={`#${t.id}`}>
                  <ProgressRing slugs={slugs} size={24} label={`${t.title} progress`} />
                  <span class="rail-tracks__name">{t.title}</span>
                  <span class="rail-tracks__count" data-progress-text>0 / {slugs.length}</span>
                </a>
              </li>
            );
          })}
        </ul>
        <ul class="rail-links">
          <li><a href="/projects/">All projects</a></li>
          <li><a href="/exercises/">Exercise library</a></li>
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/certificate/">Certificate</a></li>
        </ul>
      </div>
    </aside>

    <main id="main" class="dash-main">
      <p class="eyebrow muted">Course</p>
      <h1>Your course</h1>
      <p class="t-lead dash-lead">{cat.all.length} lessons in {cat.tracks.length} tracks, about {fmtMinutes(totalMinutes)} of reading (setup not counted). Open any lesson at any time; mark it done with one click.</p>

      <section class="resume" data-continue data-scope="all" aria-labelledby="resume-title">
        <div class="resume__text">
          <p class="eyebrow resume__eyebrow" data-continue-eyebrow>Start here</p>
          <h2 id="resume-title" class="resume__title" data-continue-title>{firstBeginner.title}</h2>
          <p class="resume__meta" data-continue-meta>Beginner · Lesson 1 of {cat.trackById.get('beginner')!.lessons.length} · {firstBeginner.minutes} min</p>
        </div>
        <a class="btn btn-primary btn-lg resume__go" href={firstBeginner.url} data-continue-link data-testid="continue">
          <span data-continue-label>Start</span> <span aria-hidden="true">→</span>
        </a>
        <div class="resume__done">
          <p class="eyebrow resume__eyebrow">Course complete</p>
          <h2 class="resume__title">Every lesson is marked complete.</h2>
          <a class="btn btn-primary btn-lg" href="/certificate/">Open your certificate →</a>
        </div>
      </section>

      <details class="skips">
        <summary><span class="skips__title">Know some of this already?</span> <span class="muted">{skips.length} ways to start where you are</span></summary>
        <ul class="skips__grid">
          {skips.map((p) => (
            <li class="skip">
              <h3 class="skip__label">{p.label}</h3>
              <p class="skip__desc">{p.description}</p>
              <div class="skip__actions">
                <a class="btn btn-sm" href={p.href}>Go to {p.startTitle} →</a>
                {p.slugs.length > 0 && (
                  <button type="button" class="btn btn-ghost btn-sm" data-bulk-toggle={p.slugs.join(',')} data-bulk-name={p.label}
                    data-label-todo={`Mark the ${p.slugs.length} skipped lessons done`} data-label-done="Undo: unmark them">
                    <span data-label>Mark the {p.slugs.length} skipped lessons done</span>
                  </button>
                )}
              </div>
            </li>
          ))}
        </ul>
      </details>

      <div class="toolbar">
        <div class="seg" role="group" aria-label="Filter lessons by level" data-level-filter>
          <button type="button" data-value="all" aria-pressed="true">All levels</button>
          <button type="button" data-value="beginner" aria-pressed="false"><span class="dot dot--b" aria-hidden="true"></span>Beginner</button>
          <button type="button" data-value="intermediate" aria-pressed="false"><span class="dot dot--i" aria-hidden="true"></span>Intermediate</button>
          <button type="button" data-value="advanced" aria-pressed="false"><span class="dot dot--a" aria-hidden="true"></span>Advanced</button>
        </div>
        <div class="toolbar__right">
          <button type="button" class="btn btn-ghost btn-sm" data-expand-all>Expand all</button>
          <button type="button" class="btn btn-ghost btn-sm" data-collapse-all>Collapse all</button>
        </div>
      </div>

      <h2 class="group-title">The path</h2>
      <p class="group-note muted">Setup is optional. Beginner, Intermediate and Advanced build on each other; {written >= cat.all.length ? `all ${cat.all.length} lessons are written.` : `${written} of ${cat.all.length} lessons are written so far, the rest show what they will cover.`}</p>
      {core.map((t) => <PathMap track={t} header headingLevel={3} />)}

      <h2 class="group-title">Project tracks</h2>
      <p class="group-note muted">Modules are folded to keep the map short: open one with its arrow, or use Expand all. Each project lists the lessons it needs first; see <a href="/projects/">all projects</a> for their quick-start checklists.</p>
      {projects.map((t) => <PathMap track={t} header headingLevel={3} collapsed />)}

      <p class="filter-empty" data-filter-empty hidden>No lessons at this level. <button type="button" class="btn btn-sm" data-level-filter-reset>Show all levels</button></p>
    </main>

    <aside class="dash-right" aria-label="Certificate and data">
      <div class="rail">
        <section class="cert-card" data-cert-progress data-core={certCore.join(',')} data-projects={JSON.stringify(certProjects)}
          data-min-projects={String(cat.certificate.minProjectTracksCompleted)} aria-labelledby="cert-title">
          <p class="eyebrow cert-card__eyebrow">Certificate</p>
          <h2 id="cert-title" class="cert-card__title" data-cert-status>0% of the way to your certificate</h2>
          <div class="cert-card__bar" aria-hidden="true"><span></span></div>
          <dl class="cert-card__stats">
            <div><dt>Core lessons</dt><dd data-cert-core>0 / {certCore.length}</dd></div>
            <div><dt>Projects done</dt><dd data-cert-projects>0 / {cat.certificate.minProjectTracksCompleted}</dd></div>
          </dl>
          <p class="cert-card__rule">{cat.certificate.description}</p>
          <a class="btn btn-sm cert-card__go" href="/certificate/">View certificate</a>
        </section>
        <p class="time-left"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5" /><path d="M10 5.5V10l3 2" /></svg><span data-time-left>About {fmtMinutes(totalMinutes)} of reading left</span></p>
        <ProgressPanel />
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .dash {
    max-width: var(--container-wide); margin: 0 auto; padding: var(--s-7) var(--gutter) 0;
    display: grid; grid-template-columns: 232px minmax(0, 1fr) 272px; gap: var(--s-7); align-items: start;
  }
  .rail { position: sticky; top: calc(var(--topbar-h) + var(--s-5)); }
  .dash-left .rail, .dash-right .rail { max-height: calc(100vh - var(--topbar-h) - var(--s-6)); overflow-y: auto; padding: 2px; }

  .overall { display: flex; align-items: center; gap: var(--s-4); margin: var(--s-3) 0 var(--s-5); }
  .overall__num { margin: 0; font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .overall__label { margin: 0; font-size: var(--t-small); color: var(--ink-3); }
  .rail-tracks, .rail-links { list-style: none; margin: 0; padding: 0; }
  .rail-tracks a { display: flex; align-items: center; gap: var(--s-3); padding: 6px var(--s-2); border-radius: var(--r-sm); text-decoration: none; color: var(--ink-2); font-size: var(--t-small); }
  .rail-tracks a:hover { background: var(--surface-2); color: var(--ink); }
  .rail-tracks__name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rail-tracks__count { font-variant-numeric: tabular-nums; color: var(--ink-3); }
  .rail-tracks li[data-complete="true"] .rail-tracks__count { color: var(--gold-text); font-weight: 600; }
  .rail-links { margin-top: var(--s-4); padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .rail-links a { display: block; padding: 6px var(--s-2); font-size: var(--t-small); text-decoration: none; border-radius: var(--r-sm); }
  .rail-links a:hover { background: var(--accent-soft); }

  .dash-main h1 { margin: var(--s-1) 0 var(--s-3); }
  .dash-lead { color: var(--ink-2); max-width: 60ch; }

  .resume {
    display: flex; align-items: center; gap: var(--s-5); padding: var(--s-5) var(--s-6); margin: var(--s-5) 0 var(--s-4);
    background: var(--accent-soft); border-radius: var(--r-lg); position: relative; overflow: hidden;
  }
  .resume::after { content: ""; position: absolute; right: -40px; top: -40px; width: 180px; height: 180px; border-radius: 50%; border: 1px solid rgb(51 64 201 / 0.14); box-shadow: 0 0 0 28px rgb(51 64 201 / 0.04); pointer-events: none; }
  .resume__text { flex: 1; min-width: 0; }
  .resume__eyebrow { color: var(--accent); margin: 0 0 var(--s-1); }
  .resume__title { font-size: 1.5rem; line-height: 2rem; margin: 0 0 var(--s-1); }
  .resume__meta { margin: 0; color: var(--ink-2); font-size: var(--t-small); }
  .resume__go { position: relative; z-index: 1; }
  .resume__done { display: none; }
  .resume[data-complete="true"] { background: linear-gradient(120deg, #FBF6E6, var(--surface)); box-shadow: inset 0 0 0 1px var(--gold-2); }
  .resume[data-complete="true"] > .resume__text, .resume[data-complete="true"] > .resume__go { display: none; }
  .resume[data-complete="true"] .resume__done { display: block; }
  .resume[data-complete="true"] .resume__eyebrow { color: var(--gold-text); }

  .skips { margin: 0 0 var(--s-5); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); }
  .skips summary { cursor: pointer; padding: var(--s-3) var(--s-5); font-size: var(--t-ui); list-style-position: inside; }
  .skips__title { font-weight: 600; }
  .skips__grid { list-style: none; margin: 0; padding: 0 var(--s-5) var(--s-5); display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-3); }
  .skip { padding: var(--s-4); border-radius: var(--r-sm); background: var(--surface-2); display: flex; flex-direction: column; }
  .skip__label { font-size: var(--t-ui); line-height: var(--lh-ui); margin: 0 0 var(--s-1); }
  .skip__desc { font-size: var(--t-small); line-height: var(--lh-small); color: var(--ink-2); margin: 0 0 var(--s-3); flex: 1; }
  .skip__actions { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .skip__actions [aria-pressed="true"] { color: var(--success); }

  .toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); margin: var(--s-6) 0 var(--s-5); position: sticky; top: var(--topbar-h); z-index: 2; background: rgb(250 247 242 / 0.92); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); padding: var(--s-2) 0; }
  .toolbar__right { display: flex; gap: var(--s-1); }
  .seg { display: inline-flex; padding: 3px; background: var(--surface-2); border-radius: var(--r-pill); }
  .seg button { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 0 var(--s-4); border: 0; border-radius: var(--r-pill); background: none; font-size: var(--t-small); font-weight: 600; color: var(--ink-2); cursor: pointer; }
  .seg button:hover { color: var(--ink); }
  .seg button[aria-pressed="true"] { background: var(--surface); color: var(--ink); box-shadow: var(--sh-1); }
  .dot { width: 8px; height: 8px; border-radius: 50%; }
  .dot--b { background: var(--lvl-beginner); }
  .dot--i { background: var(--lvl-intermediate); transform: rotate(45deg); border-radius: 1px; }
  .dot--a { background: var(--lvl-advanced); clip-path: polygon(25% 5%, 75% 5%, 100% 50%, 75% 95%, 25% 95%, 0 50%); border-radius: 0; }

  .group-title { margin: var(--s-7) 0 var(--s-1); }
  .group-note { font-size: var(--t-small); margin: 0 0 var(--s-5); }
  .filter-empty { padding: var(--s-6); text-align: center; color: var(--ink-2); }

  .cert-card { padding: var(--s-5); border-radius: var(--r-md); background: linear-gradient(160deg, #FFFDF7, #FBF5E4); box-shadow: inset 0 0 0 1px var(--gold-1), var(--sh-1); }
  .cert-card__eyebrow { color: var(--gold-text); margin: 0 0 var(--s-2); }
  .cert-card__title { font-size: 1.125rem; line-height: 1.5rem; margin: 0 0 var(--s-3); }
  .cert-card__bar { height: 6px; border-radius: 3px; background: rgb(184 137 47 / 0.15); overflow: hidden; }
  .cert-card__bar span { display: block; height: 100%; width: calc(var(--pct, 0) * 1%); background: linear-gradient(90deg, var(--gold-2), var(--gold-3)); border-radius: 3px; transition: width var(--d-slow) var(--ease-out); }
  .cert-card__stats { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); margin: var(--s-4) 0 var(--s-3); }
  .cert-card__stats dt { font-size: var(--t-micro); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); font-weight: 600; }
  .cert-card__stats dd { margin: 2px 0 0; font-family: var(--font-serif); font-size: 1.25rem; font-variant-numeric: tabular-nums; }
  .cert-card__rule { font-size: var(--t-micro); line-height: 1.45; color: var(--ink-3); margin: 0 0 var(--s-3); }
  .cert-card__go { width: 100%; }
  .cert-card[data-unlocked="true"] .cert-card__go { background: var(--gold-3); border-color: var(--gold-3); color: var(--ink-inverse); }
  .time-left { display: flex; align-items: center; gap: var(--s-2); font-size: var(--t-small); color: var(--ink-2); margin: var(--s-4) 0 var(--s-5); padding: 0 var(--s-1); }
  .time-left svg { width: 18px; height: 18px; flex: none; fill: none; stroke: var(--ink-3); stroke-width: 1.5; stroke-linecap: round; }
  .dash-right :global(.pp) { padding-top: var(--s-4); border-top: 1px solid var(--line); }

  @media (max-width: 1279px) {
    .dash { grid-template-columns: 220px minmax(0, 1fr); }
    .dash-right { grid-column: 2; }
    .dash-right .rail { position: static; max-height: none; }
  }
</style>
