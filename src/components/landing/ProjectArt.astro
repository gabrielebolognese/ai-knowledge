---
// Original line-and-shape illustrations for the six project cards (own work, token palette).
// Each shows a tiny "real output" of the project: digit grid, letter grid, doodle strokes,
// generated text, code completion ghost text, and a chess board with an evaluation bar.
interface Props { kind: 'digit' | 'letter' | 'doodle' | 'text' | 'code' | 'chess'; }
const { kind } = Astro.props;

const grid = (rows: string[], cell: number, x0: number, y0: number) =>
  rows.flatMap((row, r) => row.split('').map((c, col) => ({ x: x0 + col * cell, y: y0 + r * cell, on: c !== '0', soft: c === '2' })));

// 7x9 pixel "3" and "A" (2 = anti-aliased edge pixel)
const three = ['0111110', '1200021', '0000021', '0011110', '0000121', '0000001', '1000021', '1211121', '0111110'];
const letterA = ['0001000', '0012100', '0021200', '0120210', '0200020', '1211121', '1111111', '1000001', '1000001'];
const digitBars = [2, 1, 3, 92, 1, 4, 1, 2, 3, 1];

// Chess: a 6x6 corner of a board with a few pieces (Unicode chess symbols rendered as text).
const pieces = [
  { f: 1, r: 0, s: '♜' }, { f: 4, r: 0, s: '♚' }, { f: 0, r: 1, s: '♟' }, { f: 2, r: 2, s: '♞' },
  { f: 3, r: 3, s: '♙' }, { f: 4, r: 4, s: '♘' }, { f: 1, r: 5, s: '♖' }, { f: 5, r: 5, s: '♔' },
];
---
<svg class={`pa pa--${kind}`} viewBox="0 0 320 180" role="img" aria-hidden="true" focusable="false">
  <rect width="320" height="180" fill="#F3EEE6" />
  {kind === 'digit' && (
    <g>
      <rect x="28" y="30" width="120" height="120" rx="10" fill="#FFFFFF" stroke="#E6DFD3" />
      {grid(three, 11, 50, 41).map((p) => p.on && <rect x={p.x} y={p.y} width="10" height="10" rx="2" fill={p.soft ? '#8F8677' : '#1B1A17'} />)}
      <g transform="translate(176 33)">
        {digitBars.map((v, i) => (
          <g transform={`translate(0 ${i * 11.5})`}>
            <text x="0" y="8" class="pa-mono pa-xs">{i}</text>
            <rect x="14" y="2" width="104" height="6" rx="3" fill="#EAE3D7" />
            <rect x="14" y="2" width={Math.max(3, (104 * v) / 100)} height="6" rx="3" fill={v > 50 ? '#3340C9' : '#B9B1A3'} />
          </g>
        ))}
      </g>
    </g>
  )}
  {kind === 'letter' && (
    <g>
      {['B', 'q', 'R'].map((ch, i) => (
        <text x={34 + i * 34} y={66} class="pa-hand" transform={`rotate(${i * 5 - 5} ${40 + i * 34} 56)`}>{ch}</text>
      ))}
      <rect x="150" y="30" width="120" height="120" rx="10" fill="#FFFFFF" stroke="#E6DFD3" />
      {grid(letterA, 11, 172, 41).map((p) => p.on && <rect x={p.x} y={p.y} width="10" height="10" rx="2" fill={p.soft ? '#8F8677' : '#1B1A17'} />)}
      <g transform="translate(34 104)">
        <rect width="92" height="42" rx="10" fill="#FFFFFF" stroke="#E6DFD3" />
        <text x="14" y="27" class="pa-serif">A</text>
        <text x="40" y="27" class="pa-ui">94%</text>
        <rect x="14" y="33" width="64" height="3" rx="1.5" fill="#6D3FC4" />
      </g>
      <path d="M128 125 C 140 125, 140 92, 150 92" fill="none" stroke="#8F8677" stroke-dasharray="2 3" />
    </g>
  )}
  {kind === 'doodle' && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <rect x="28" y="24" width="150" height="132" rx="10" fill="#FFFFFF" stroke="#E6DFD3" />
      <g stroke="#1B1A17" stroke-width="3">
        <path d="M60 128 L60 88 L103 58 L146 88 L146 128 Z" />
        <path d="M92 128 V104 H114 V128" />
        <path d="M120 70 V54 H132 V79" />
      </g>
      <path class="pa-stroke" d="M50 140 C 80 136, 120 142, 158 138" stroke="#3340C9" stroke-width="2.5" />
      <g transform="translate(196 44)">
        {([['house', 96, '#3340C9'], ['barn', 3, '#8F8677'], ['tent', 1, '#8F8677']] as [string, number, string][]).map(([n, p, c], i) => (
          <g transform={`translate(0 ${i * 32})`}>
            <rect width="100" height="26" rx="13" fill={i === 0 ? '#ECEEFC' : '#FFFFFF'} stroke={i === 0 ? '#3340C9' : '#E6DFD3'} />
            <text x="12" y="17" class="pa-ui" fill={i === 0 ? '#2A37B0' : '#4A463F'} stroke="none">{n}</text>
            <text x="88" y="17" class="pa-ui pa-end" fill={c} stroke="none">{p}%</text>
          </g>
        ))}
      </g>
    </g>
  )}
  {kind === 'text' && (
    <g>
      <rect x="28" y="24" width="264" height="132" rx="10" fill="#FFFFFF" stroke="#E6DFD3" />
      <text x="46" y="50" class="pa-label">generated names</text>
      {['mariella', 'joren', 'kaylin'].map((n, i) => (
        <text x="46" y={76 + i * 22} class="pa-mono pa-lg">{n}</text>
      ))}
      <line x1="168" y1="40" x2="168" y2="140" stroke="#E6DFD3" />
      <text x="186" y="50" class="pa-label">sentiment</text>
      <text x="186" y="78" class="pa-ui">“loved it!”</text>
      <g transform="translate(186 88)">
        <rect width="78" height="22" rx="11" fill="#E6F3EA" />
        <text x="12" y="15" class="pa-ui" fill="#1E7B3F">positive</text>
      </g>
      <text x="186" y="134" class="pa-mono" fill="#6B655A">p = 0.91</text>
    </g>
  )}
  {kind === 'code' && (
    <g>
      <rect x="28" y="24" width="264" height="132" rx="10" fill="#FFFFFF" stroke="#E6DFD3" />
      <circle cx="44" cy="38" r="3.5" fill="#EAE3D7" /><circle cx="56" cy="38" r="3.5" fill="#EAE3D7" /><circle cx="68" cy="38" r="3.5" fill="#EAE3D7" />
      <text x="44" y="68" class="pa-mono"><tspan fill="#6D3FC4">def</tspan> <tspan fill="#2A37B0">mean</tspan>(xs):</text>
      <text x="62" y="88" class="pa-mono"><tspan fill="#6D3FC4">if not</tspan> xs:</text>
      <text x="80" y="108" class="pa-mono"><tspan fill="#6D3FC4">return</tspan> <tspan fill="#B4233C">0.0</tspan></text>
      <text x="62" y="128" class="pa-mono"><tspan fill="#6D3FC4">return</tspan> <tspan class="pa-ghost">sum(xs) / len(xs)</tspan></text>
      <rect class="pa-caret" x="112" y="117" width="1.6" height="14" fill="#3340C9" />
      <g transform="translate(198 136)">
        <rect width="70" height="20" rx="6" fill="#F3EEE6" />
        <text x="10" y="14" class="pa-label" fill="#4A463F">Tab ↹ accept</text>
      </g>
    </g>
  )}
  {kind === 'chess' && (
    <g>
      <g transform="translate(40 18)">
        {Array.from({ length: 36 }, (_, i) => {
          const f = i % 6, r = Math.floor(i / 6);
          return <rect x={f * 24} y={r * 24} width="24" height="24" fill={(f + r) % 2 ? '#C9BFAE' : '#FFFFFF'} />;
        })}
        <rect width="144" height="144" fill="none" stroke="#8F8677" />
        {pieces.map((p) => <text x={p.f * 24 + 12} y={p.r * 24 + 19} class="pa-piece">{p.s}</text>)}
        <path d="M108 108 L84 60" stroke="#3340C9" stroke-width="3" stroke-linecap="round" opacity="0.75" />
        <circle cx="84" cy="60" r="4" fill="#3340C9" />
      </g>
      <g transform="translate(206 18)">
        <rect width="14" height="144" rx="3" fill="#1B1A17" />
        <rect y="0" width="14" height="94" rx="3" fill="#FFFFFF" stroke="#8F8677" />
        <text x="26" y="98" class="pa-serif pa-sm">+0.8</text>
        <text x="26" y="116" class="pa-label">eval</text>
        <text x="26" y="28" class="pa-label">depth 4</text>
        <text x="26" y="44" class="pa-mono" fill="#4A463F">e4→d6</text>
      </g>
    </g>
  )}
</svg>

<style>
  .pa { display: block; width: 100%; height: auto; }
  .pa-mono { font: 500 12px var(--font-mono); fill: var(--ink-2); font-variant-ligatures: none; }
  .pa-xs { font-size: 9.5px; }
  .pa-lg { font-size: 15px; fill: var(--ink); }
  .pa-ui { font: 500 12px var(--font-sans); fill: var(--ink-2); }
  .pa-end { text-anchor: end; }
  .pa-label { font: 600 9.5px var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase; fill: var(--ink-3); }
  .pa-serif { font: 500 24px var(--font-serif); fill: var(--ink); }
  .pa-sm { font-size: 20px; }
  .pa-hand { font: italic 400 34px var(--font-serif); fill: var(--ink-2); }
  .pa-piece { font: 20px "Segoe UI Symbol", "DejaVu Sans", "Noto Sans Symbols 2", serif; text-anchor: middle; fill: var(--ink); }
  .pa-ghost { fill: #B0A898; font-style: italic; }
  @media (prefers-reduced-motion: no-preference) {
    .pa-caret { animation: pa-blink 1.1s steps(1) infinite; }
    .pa-stroke { stroke-dasharray: 120; stroke-dashoffset: 0; }
    :global(.project-card:hover) .pa-stroke { animation: pa-draw 900ms var(--ease-out); }
  }
  @keyframes pa-blink { 50% { opacity: 0; } }
  @keyframes pa-draw { from { stroke-dashoffset: 120; } to { stroke-dashoffset: 0; } }
</style>
