---
// Landing hero art: a small neural network drawn from our own SVG primitives.
// Values "flow" left to right along the edges on a 6 s loop; hovering or focusing a node
// highlights its connections. Static under prefers-reduced-motion.

const W = 520;
const H = 440;
const layers = [3, 5, 5, 2];
const xs = [70, 205, 340, 460];
const nodes = layers.map((n, li) =>
  Array.from({ length: n }, (_, i) => ({
    id: `n${li}-${i}`,
    layer: li,
    x: xs[li],
    y: H / 2 + (i - (n - 1) / 2) * (n === 2 ? 120 : n === 3 ? 92 : 72),
  })),
);
// Deterministic pseudo-weights so the art looks "trained" but never changes between builds.
const w = (a: number, b: number) => Math.abs(Math.sin(a * 12.9898 + b * 78.233) * 43758.5453) % 1;
const edges: { id: string; from: string; to: string; x1: number; y1: number; x2: number; y2: number; weight: number; layer: number }[] = [];
for (let li = 0; li < layers.length - 1; li++) {
  for (const a of nodes[li]) {
    for (const b of nodes[li + 1]) {
      edges.push({ id: `${a.id}_${b.id}`, from: a.id, to: b.id, x1: a.x, y1: a.y, x2: b.x, y2: b.y, weight: w(edges.length + 1, li + 3), layer: li });
    }
  }
}
// Activation intensity per node (0..1), used for fill tint.
const act = (id: string) => w(id.length * 7 + Number(id.split('-')[1]) * 3, Number(id[1]) + 1);
const outputs = [
  { label: '“7”', p: 96 },
  { label: '“1”', p: 3 },
];
// A 5x7 pixel "7" as the input picture.
const seven = [
  '11111',
  '00001',
  '00010',
  '00100',
  '00100',
  '01000',
  '01000',
];
---
<figure class="hero-net" data-hero-net aria-label="Illustration: a small neural network reads a handwritten 7 and outputs 96% confidence">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="hn-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#3340C9" stop-opacity="0.16" />
        <stop offset="100%" stop-color="#3340C9" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="300" cy="220" r="210" fill="url(#hn-glow)" />

    <!-- input picture -->
    <g transform="translate(6 148)" class="hn-pixels">
      <rect x="-6" y="-6" width="52" height="68" rx="8" fill="#FFFFFF" stroke="#E6DFD3" />
      {seven.flatMap((row, r) => row.split('').map((c, col) => (
        <rect x={col * 8 + 1} y={r * 8 + 1} width="7" height="7" rx="1.5" fill={c === '1' ? '#1B1A17' : '#F3EEE6'} />
      )))}
    </g>
    <path d="M52 182 C 58 182, 60 220, 70 220" fill="none" stroke="#8F8677" stroke-width="1" stroke-dasharray="2 3" />

    <g class="hn-edges">
      {edges.map((e) => (
        <line class="hn-edge" data-from={e.from} data-to={e.to} x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2}
          stroke-width={(0.5 + e.weight * 1.1).toFixed(2)} stroke-opacity={(0.16 + e.weight * 0.3).toFixed(2)} />
      ))}
    </g>
    <g class="hn-pulses">
      {edges.filter((e) => e.weight > 0.45).map((e) => (
        <line class="hn-pulse" pathLength="100" x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2}
          style={`--delay:${(e.layer * 1.1 + e.weight * 0.6).toFixed(2)}s`} />
      ))}
    </g>
    <g class="hn-nodes">
      {nodes.flat().map((n) => (
        <g class="hn-node" data-node={n.id} tabindex="-1">
          <circle class="hn-halo" cx={n.x} cy={n.y} r="20" />
          <circle class="hn-dot" cx={n.x} cy={n.y} r={n.layer === 3 ? 15 : 12}
            fill={n.layer === 3 && n.y < H / 2 ? '#3340C9' : `rgb(51 64 201 / ${(0.08 + act(n.id) * 0.32).toFixed(2)})`} />
        </g>
      ))}
    </g>
    {outputs.map((o, i) => {
      const n = nodes[3][i];
      return (
        <g transform={`translate(${n.x + 22} ${n.y - 9})`} class="hn-out">
          <text x="0" y="13" class="hn-out__label">{o.label}</text>
          <rect x="0" y="20" width="44" height="5" rx="2.5" fill="#EAE3D7" />
          <rect x="0" y="20" width={(44 * o.p) / 100} height="5" rx="2.5" fill={i === 0 ? '#3340C9' : '#8F8677'} />
        </g>
      );
    })}
    <g class="hn-legend">
      <text x="70" y="420">input</text>
      <text x="272" y="420">hidden layers</text>
      <text x="460" y="420">output</text>
    </g>
  </svg>
  <div class="hn-card hn-card--pred">
    <span class="hn-card__k">Prediction</span>
    <span class="hn-card__v">7 <small>· 96%</small></span>
  </div>
  <div class="hn-card hn-card--cite">
    <span class="hn-card__sup">[4]</span>
    <span>LeCun et al., 1998 · <em>Proc. IEEE</em></span>
  </div>
</figure>

<script>
  const fig = document.querySelector<HTMLElement>('[data-hero-net]');
  if (fig) {
    const edges = Array.from(fig.querySelectorAll<SVGLineElement>('.hn-edge'));
    const clear = () => { fig.classList.remove('is-focus'); edges.forEach((e) => e.classList.remove('is-on')); fig.querySelectorAll('.hn-node.is-on').forEach((n) => n.classList.remove('is-on')); };
    fig.querySelectorAll<SVGGElement>('.hn-node').forEach((node) => {
      const id = node.dataset.node!;
      node.addEventListener('pointerenter', () => {
        clear();
        fig.classList.add('is-focus');
        node.classList.add('is-on');
        edges.forEach((e) => {
          if (e.dataset.from === id || e.dataset.to === id) {
            e.classList.add('is-on');
            const other = e.dataset.from === id ? e.dataset.to : e.dataset.from;
            fig.querySelector(`[data-node="${other}"]`)?.classList.add('is-on');
          }
        });
      });
      node.addEventListener('pointerleave', clear);
    });
    // Pause the flow when the tab is hidden.
    document.addEventListener('visibilitychange', () => fig.classList.toggle('is-paused', document.hidden));
  }
</script>

<style>
  .hero-net { position: relative; margin: 0; width: 100%; max-width: 560px; justify-self: end; }
  .hero-net svg { display: block; width: 100%; height: auto; overflow: visible; }
  .hn-edge { stroke: #8F8677; transition: stroke var(--d-base), stroke-opacity var(--d-base); }
  .hn-pulse { stroke: #3340C9; stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 9 100; stroke-dashoffset: 109; opacity: 0; }
  .hn-dot { stroke: #3340C9; stroke-width: 1.5; transition: transform var(--d-base) var(--ease-out); transform-box: fill-box; transform-origin: center; }
  .hn-halo { fill: #3340C9; opacity: 0; transition: opacity var(--d-base); }
  .hn-node { cursor: pointer; outline: none; }
  .hn-node.is-on .hn-halo { opacity: 0.12; }
  .hn-node.is-on .hn-dot { transform: scale(1.12); }
  .is-focus .hn-edge { stroke-opacity: 0.08; }
  .is-focus .hn-edge.is-on { stroke: #3340C9; stroke-opacity: 0.85; }
  .hn-out__label { font: 600 15px var(--font-serif); fill: var(--ink); }
  .hn-legend text { font: 600 10.5px var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase; fill: var(--ink-3); text-anchor: middle; }

  .hn-card {
    position: absolute; display: flex; align-items: center; gap: var(--s-2);
    background: var(--surface); border-radius: var(--r-sm); box-shadow: var(--sh-2);
    padding: var(--s-2) var(--s-3); font-size: var(--t-small); color: var(--ink-2);
  }
  .hn-card--pred { right: -8px; top: 24px; flex-direction: column; align-items: flex-start; gap: 0; padding: var(--s-3) var(--s-4); }
  .hn-card__k { font-size: var(--t-micro); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; color: var(--ink-3); }
  .hn-card__v { font-family: var(--font-serif); font-size: 1.75rem; line-height: 1.1; color: var(--ink); font-variation-settings: "opsz" 72; }
  .hn-card__v small { font-family: var(--font-sans); font-size: var(--t-ui); color: var(--success); font-weight: 600; }
  .hn-card--cite { left: 0; top: 40px; }
  .hn-card__sup { color: var(--link); font-weight: 600; font-size: var(--t-micro); }

  @media (prefers-reduced-motion: no-preference) {
    .hn-pulse { animation: hn-flow 6s var(--ease-in-out) infinite; animation-delay: var(--delay); }
    .is-paused .hn-pulse { animation-play-state: paused; }
    .hn-card--pred { animation: hn-float 7s ease-in-out infinite; }
    .hn-card--cite { animation: hn-float 8s ease-in-out 1.2s infinite; }
  }
  @keyframes hn-flow {
    0% { stroke-dashoffset: 109; opacity: 0; }
    6% { opacity: 1; }
    30% { stroke-dashoffset: 0; opacity: 1; }
    36%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes hn-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
</style>
